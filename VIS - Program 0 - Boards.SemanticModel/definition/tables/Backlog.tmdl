table Backlog
	lineageTag: b278297f-679d-4d2b-ad41-8d6bcb891eb0

	measure 'Open Work Items' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( Backlog[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        Backlog[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( Backlog[WorkItemId] ), TeamAreaFilter )
		formatString: #,0
		lineageTag: 65ac2df0-b5fe-4ec4-9dbe-7d7dc4dd41f5

	measure 'Slow Movers Count' =
			VAR DataAsOfDate =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot' )
			    )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( Backlog[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        Backlog[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        Backlog[WorkItemType] = "User Story",
			        TeamAreaFilter,
			        FILTER (
			            Backlog,
			            NOT ( Backlog[State] IN { "In Concept", "On Hold" } ) &&
			            NOT ISBLANK ( Backlog[ChangedDate] ) &&
			            DATEDIFF ( Backlog[ChangedDate], DataAsOfDate, DAY ) > 30
			        )
			    )
		formatString: #,0
		lineageTag: e7a4939d-e919-40aa-b0c5-64187117c42d

	measure 'Slow Movers %' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( Backlog[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        Backlog[AreaPath] IN SelectedAreas
			    )
			VAR OpenStories =
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        Backlog[WorkItemType] = "User Story",
			        KEEPFILTERS (
			            FILTER (
			                VALUES ( Backlog[State] ),
			                NOT ( Backlog[State] IN { "In Concept", "On Hold" } )
			            )
			        ),
			        TeamAreaFilter
			    )
			RETURN
			    DIVIDE ( [Slow Movers Count], OpenStories )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7b54faad-e0b9-454d-b7b1-279e13577eb8

	measure 'Average Days Open' = AVERAGE ( Backlog[DaysOpen] )
		formatString: #,0.0
		lineageTag: 18d1fe54-c5db-412f-9060-170d3e191e4f

	measure 'Missing Estimate %' =
			VAR MissingEstimateCount =
			    CALCULATE (
			        COUNTROWS ( Backlog ),
			        FILTER (
			            Backlog,
			            Backlog[Missing Estimate] = "true" ||
			            Backlog[Missing Estimate] = "True" ||
			            Backlog[Missing Estimate] = "TRUE"
			        )
			    )
			RETURN
			    DIVIDE ( MissingEstimateCount, [Open Work Items] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ebd1faeb-b6f7-4a5c-aa01-831491a4f3f1

	measure 'Unique Team Members (Open)' =
			CALCULATE (
			    DISTINCTCOUNT ( Backlog[UserEmail] ),
			    FILTER (
			        Backlog,
			        NOT ISBLANK ( Backlog[UserEmail] ) && Backlog[UserEmail] <> "NoAssignee"
			    )
			)
		formatString: #,0
		lineageTag: 6cc9c79e-943b-4857-83b2-02fcf8cef263

	measure 'Estimated Effort per Team Member' =
			DIVIDE (
			    SUMX (
			        VALUES ( Backlog[WorkItemId] ),
			        CALCULATE ( MAX ( Backlog[Estimated Effort Dev] ) )
			    ),
			    [Unique Team Members (Open)]
			)
		formatString: #,0.0
		lineageTag: f68f411f-d44b-4f31-a74a-fd9e39e8575e

	measure 'Actual Effort per Team Member' = DIVIDE ( SUM ( Backlog[Actual Effort Dev] ), [Unique Team Members (Open)] )
		formatString: #,0.0
		lineageTag: 9479b3f1-bf6d-4e7b-9058-befbe4e9543b

	measure 'Slow Mover Days' =
			VAR DataAsOfDate =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot' )
			    )
			RETURN
			    SUMX (
			        VALUES ( Backlog[WorkItemId] ),
			        VAR LastChanged =
			            CALCULATE (
			                MAX ( Backlog[ChangedDate] ),
			                Backlog[WorkItemType] = "User Story"
			            )
			        RETURN
			            IF (
			                NOT ISBLANK ( LastChanged ) &&
			                NOT (
			                    CALCULATE ( SELECTEDVALUE ( Backlog[State] ) )
			                        IN { "In Concept", "On Hold" }
			                ),
			                DATEDIFF ( LastChanged, DataAsOfDate, DAY )
			            )
			    )
		formatString: #,0
		lineageTag: 0e88950e-3dee-4348-aa6e-8f6eaf52fca4

	measure 'Long Runner Days' =
			SUMX (
			    VALUES ( Backlog[WorkItemId] ),
			    IF (
			        NOT ( CALCULATE ( SELECTEDVALUE ( Backlog[State] ) ) IN { "In Concept", "On Hold" } ),
			        CALCULATE (
			            MAX ( Backlog[DaysActive] ),
			            Backlog[WorkItemType] = "User Story"
			        )
			    )
			)
		formatString: #,0
		lineageTag: 0e88950e-3dee-4348-aa6e-8f6eaf52fca5

	measure 'Slow Movers % Color' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Slow Movers %] ), "#6B7280",
			    [Slow Movers %] <= 0.15, "#2E7D32",
			    [Slow Movers %] <= 0.25, "#EF6C00",
			    "#C62828"
			)
		lineageTag: 936fe4a3-a1be-4986-8a1c-a77115c7cfeb

	measure 'Estimated Effort per Team Member Color' =
			SWITCH (
			    TRUE (),
			    [Estimated Effort per Team Member] > 30, "#C62828",
			    [Estimated Effort per Team Member] > 20, "#2E7D32",
			    "#EF6C00"
			)
		lineageTag: b00bc51f-a507-4602-95c9-244c704422ce

	measure 'Slow Movers % Current Backlog' =
			CALCULATE (
			    [Slow Movers %],
			    REMOVEFILTERS ( Backlog[CreatedDate] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c57b4831-bd17-4816-b580-fbb52c0e739c

	measure 'Management Attention Days' =
			VAR DataAsOfDate =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot' )
			    )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( Backlog[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        Backlog[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        MAXX (
			            VALUES ( Backlog[WorkItemId] ),
			            VAR LastChanged = CALCULATE ( MAX ( Backlog[ChangedDate] ) )
			            RETURN
			                IF (
			                    NOT ISBLANK ( LastChanged ) &&
			                    NOT ( CALCULATE ( SELECTEDVALUE ( Backlog[State] ) ) IN { "In Concept", "On Hold" } ),
			                    DATEDIFF ( LastChanged, DataAsOfDate, DAY )
			                )
			        ),
			        Backlog[WorkItemType] = "User Story",
			        TeamAreaFilter
			    )
		formatString: #,0
		lineageTag: 6919f82d-9b59-4a45-a6d5-7005062fc4ee

	measure 'Open Stories by Age Band' =
			VAR DataAsOfDate =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot' )
			    )
			VAR MinimumDays = SELECTEDVALUE ( 'Executive Age Band'[Minimum Days] )
			VAR MaximumDays = SELECTEDVALUE ( 'Executive Age Band'[Maximum Days] )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( Backlog[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        Backlog[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        Backlog[WorkItemType] = "User Story",
			        TeamAreaFilter,
			        FILTER (
			            Backlog,
			            NOT ( Backlog[State] IN { "In Concept", "On Hold" } ) &&
			            NOT ISBLANK ( Backlog[ChangedDate] ) &&
			            VAR AgeDays = DATEDIFF ( Backlog[ChangedDate], DataAsOfDate, DAY )
			            RETURN AgeDays >= MinimumDays && AgeDays <= MaximumDays
			        )
			    )
		formatString: #,0
		lineageTag: a8e7da15-310f-42f7-977a-6e1f41a873cb

