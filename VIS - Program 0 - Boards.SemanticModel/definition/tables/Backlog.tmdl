	column DaysOpen =
			
			IF (
			    ISBLANK ( Backlog[CreatedDate] ),
			    BLANK (),
			    DATEDIFF ( Backlog[CreatedDate], COALESCE ( Backlog[ClosedDate], TODAY() ), DAY )
			)
		formatString: 0
		lineageTag: c198eaf7-8026-48fc-a751-7f5603c4826b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysActive =
			
			IF (
			    ISBLANK ( Backlog[ActivatedDate] ),
			    BLANK (),
			    DATEDIFF ( Backlog[ActivatedDate], COALESCE ( Backlog[ClosedDate], TODAY() ), DAY )
			)
		formatString: 0
		lineageTag: 8d3e591e-8d29-471a-b539-a210a2659148
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Slow Mover' =
			
			IF (
			    ISBLANK ( Backlog[ChangedDate] ) ||
			    Backlog[State] IN { "In Concept", "On Hold" },
			    BLANK (),
			    DATEDIFF ( DATEVALUE ( Backlog[ChangedDate] ), TODAY(), DAY ) > 30
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: d1fe1e91-b04e-4291-82f6-f8f3a3c74e75
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Long Runner' =
			
			IF (
			    ISBLANK ( Backlog[DaysActive] ) ||
			    Backlog[State] IN { "In Concept", "On Hold" },
			    BLANK (),
			    Backlog[DaysActive] > 30
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5229d4c2-23de-4739-b2eb-15f332a06d2e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Backlog = m
