			    )
		lineageTag: 7479a82d-c265-4b6e-9bf7-c09ac9c33246

	measure 'Story Throughput (90d) Color' =
			VAR EndDate = TODAY ()
			VAR CurrentValue = [Story Throughput (90d)]
			VAR PreviousValue =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 179 &&
			            'Done Work'[ClosedDate] <= EndDate - 90
			        )
			    )
			VAR ChangeRatio = DIVIDE ( CurrentValue - PreviousValue, PreviousValue )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentValue ) || ISBLANK ( PreviousValue ), "#6B7280",
			        ChangeRatio >= 0.1, "#2E7D32",
			        ChangeRatio >= -0.1, "#EF6C00",
			        "#C62828"
			    )
		lineageTag: 931948af-664d-4261-928b-73570e03bfc3

	measure 'Estimated Effort per Team Member (90d Monthly Avg)' =
			VAR EndDate = TODAY ()
			VAR DateWindow =
			    FILTER (
			        ALL ( 'Done Work'[ClosedDate] ),
			        'Done Work'[ClosedDate] >= EndDate - 89 &&
			        'Done Work'[ClosedDate] <= EndDate
			    )
			VAR EstimatedEffort90d =
			    CALCULATE (
			        SUMX (
			            VALUES ( 'Done Work'[WorkItemId] ),
			            CALCULATE ( MAX ( 'Done Work'[Estimated Effort Dev] ) )
			        ),
			        DateWindow
			    )
			VAR TeamMembers90d =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[UserName] ),
			        DateWindow,
			        NOT ISBLANK ( 'Done Work'[UserName] ),
			        'Done Work'[UserName] <> "NoAssignee"
			    )
			RETURN
			    DIVIDE ( EstimatedEffort90d, TeamMembers90d * 3 )
		formatString: #,0.0
		lineageTag: f132711a-bf6d-4aee-8028-4f5fd9aa5f9e

	measure 'Estimated Effort per Team Member (90d) Color' =
			SWITCH (
			    TRUE (),
			    [Estimated Effort per Team Member (90d Monthly Avg)] > 30, "#C62828",
			    [Estimated Effort per Team Member (90d Monthly Avg)] > 20, "#2E7D32",
			    "#EF6C00"
			)
		lineageTag: 8511f0d3-f475-488f-8db3-764ad861839e

	measure 'Delivered Estimated Effort' =
			SUMX (
			    VALUES ( 'Done Work'[WorkItemId] ),
			    CALCULATE ( MAX ( 'Done Work'[Estimated Effort Dev] ) )
			)
		formatString: #,0.0
		lineageTag: ed851ddb-f1e8-48a7-a14c-70f970e2653b

