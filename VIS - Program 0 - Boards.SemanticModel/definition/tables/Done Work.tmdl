			    )
		formatString: #,0
		lineageTag: 51c11f7e-a9ec-4903-a065-0c22572945b7

	measure 'Completed Actual Effort Dev' =
			SUMX (
			    VALUES ( 'Done Work'[WorkItemId] ),
