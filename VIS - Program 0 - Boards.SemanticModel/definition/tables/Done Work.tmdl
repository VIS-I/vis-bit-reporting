	measure 'Median Lead Time (90d) Color' =
			VAR EndDate = TODAY ()
			VAR CurrentValue = [Median Lead Time (90d)]
			VAR PreviousValue =
			    CALCULATE (
			        [Median Lead Time],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 179 &&
			            'Done Work'[ClosedDate] <= EndDate - 90
			        )
			    )
			VAR ChangeRatio = DIVIDE ( CurrentValue - PreviousValue, PreviousValue )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentValue ) || ISBLANK ( PreviousValue ), "#6B7280",
			        ChangeRatio <= -0.1, "#2E7D32",
			        ChangeRatio <= 0.1, "#EF6C00",
			        "#C62828"
			    )
		lineageTag: c44a1888-c02f-4a79-a9f1-a58d68183af9

	measure 'Median Cycle Time (90d) Color' =
			VAR EndDate = TODAY ()
			VAR CurrentValue = [Median Cycle Time (90d)]
			VAR PreviousValue =
			    CALCULATE (
			        [Median Cycle Time],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 179 &&
			            'Done Work'[ClosedDate] <= EndDate - 90
			        )
			    )
			VAR ChangeRatio = DIVIDE ( CurrentValue - PreviousValue, PreviousValue )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentValue ) || ISBLANK ( PreviousValue ), "#6B7280",
			        ChangeRatio <= -0.1, "#2E7D32",
			        ChangeRatio <= 0.1, "#EF6C00",
			        "#C62828"
			    )
		lineageTag: 28403f44-4eda-4127-8666-61e025db928f

	measure 'Defect Rate (90d) Color' =
			VAR EndDate = TODAY ()
			VAR CurrentValue = [Defect Rate (90d)]
			VAR PreviousValue =
			    CALCULATE (
			        [Defect Rate],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 179 &&
			            'Done Work'[ClosedDate] <= EndDate - 90
