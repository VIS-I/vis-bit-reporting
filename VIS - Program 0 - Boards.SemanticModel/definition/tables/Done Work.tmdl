table 'Done Work'
	lineageTag: e77aee8e-2a48-4c53-bb8e-9112d0d79c9a

	measure 'Completed Items' = COUNTROWS ( 'Done Work' )
		formatString: #,0
		lineageTag: c99e151a-4613-48aa-9fe6-22c21f3285e0

	measure 'Throughput (30d)' =
			VAR EndDate = TODAY ()
			RETURN
			    CALCULATE (
			        [Completed Items],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 29 &&
			            'Done Work'[ClosedDate] <= EndDate
			        )
			    )
		formatString: #,0
		lineageTag: 2f342f28-fcb4-4b44-82c4-848fd8e0e445

	measure 'Throughput (90d)' =
			VAR EndDate = TODAY ()
			RETURN
			    CALCULATE (
			        [Completed Items],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 89 &&
			            'Done Work'[ClosedDate] <= EndDate
			        )
			    )
		formatString: #,0
		lineageTag: 6eb9fca9-a577-4ec5-96ca-0a0ddeead5bc

	measure 'Average Lead Time' = AVERAGE ( 'Done Work'[Lead Time Days] )
		formatString: #,0.0
		lineageTag: 8eac40d2-c64c-423f-bce8-cfe1a220dc2b

	measure 'Average Cycle Time' = AVERAGE ( 'Done Work'[Cycle Time Days] )
		formatString: #,0.0
		lineageTag: d9d9207d-17c7-4aa2-b33a-6e36861c1dc7

	measure 'Median Lead Time' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Done Work'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Done Work'[AreaPath] IN SelectedAreas
			    )
			RETURN
			CALCULATE (
			    MEDIAN ( 'Done Work'[Lead Time Days] ),
			    'Done Work'[WorkItemType] = "User Story",
			    TeamAreaFilter
			)
		formatString: #,0.0
		lineageTag: 736cece9-1862-4f06-9d74-0dfe2f77efac

	measure 'Median Cycle Time' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Done Work'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Done Work'[AreaPath] IN SelectedAreas
			    )
			RETURN
			CALCULATE (
			    MEDIAN ( 'Done Work'[Cycle Time Days] ),
			    'Done Work'[WorkItemType] = "User Story",
			    TeamAreaFilter
			)
		formatString: #,0.0
		lineageTag: d1c74586-8f89-4b97-9966-d6d64e9cef7d

	measure 'Story Throughput (30d)' =
			VAR EndDate = TODAY ()
			RETURN
			    CALCULATE (
			        [Story Throughput],
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= EndDate - 29 &&
			            'Done Work'[ClosedDate] <= EndDate
			        )
			    )
		formatString: #,0
		lineageTag: 42d14695-d00a-4b4c-bbd3-92e2e363072e

	measure 'Defect Rate' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Done Work'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Done Work'[AreaPath] IN SelectedAreas
			    )
			VAR CompletedBugs =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        REMOVEFILTERS ( 'Done Work'[WorkItemType] ),
			        'Done Work'[WorkItemType] = "Bug",
			        TeamAreaFilter
			    )
			VAR CompletedStories =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        REMOVEFILTERS ( 'Done Work'[WorkItemType] ),
			        'Done Work'[WorkItemType] = "User Story",
			        TeamAreaFilter
			    )
			RETURN
			    DIVIDE ( CompletedBugs, CompletedBugs + CompletedStories )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e050c43e-889a-4d9f-8685-c1d562af3697

