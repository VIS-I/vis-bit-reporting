	measure 'Delivered Estimated Effort Trend (3m)' =
			VAR WindowStart = EOMONTH ( TODAY (), -3 ) + 1
			RETURN
			    IF (
			        MAX ( 'Done Work'[ClosedDate] ) >= WindowStart,
			        [Delivered Estimated Effort]
			    )
		formatString: #,0.0
		lineageTag: af97e4c4-840b-465f-aab1-9accc350225b

