table 'Cumulative Flow Diagram'
	lineageTag: 411fa070-cac6-4d4d-b507-041363424864

	measure 'Current WIP' =
			VAR SnapshotDate = MAX ( 'Cumulative Flow Diagram'[DateValue] )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Cumulative Flow Diagram'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Cumulative Flow Diagram'[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        SUM ( 'Cumulative Flow Diagram'[Count] ),
			        TeamAreaFilter,
			        FILTER (
			            'Cumulative Flow Diagram',
			            'Cumulative Flow Diagram'[DateValue] = SnapshotDate &&
			            NOT ( 'Cumulative Flow Diagram'[State] IN { "Done", "Closed", "Removed", "Completed" } )
			        )
			    )
		formatString: #,0
		lineageTag: 23014151-00f5-475d-ad0a-c4692ea8faf1

	measure 'WIP Trend (30d Avg)' =
			VAR EndDate = MAX ( 'Cumulative Flow Diagram'[DateValue] )
			VAR DatesInWindow =
			    FILTER (
			        VALUES ( 'Cumulative Flow Diagram'[DateValue] ),
			        'Cumulative Flow Diagram'[DateValue] > EndDate - 30 &&
			        'Cumulative Flow Diagram'[DateValue] <= EndDate
			    )
			RETURN
			    AVERAGEX ( DatesInWindow, [Current WIP] )
		formatString: #,0.0
		lineageTag: d6fb8942-66a1-44eb-bd72-41f761d755af

	measure 'Current WIP Color' =
			VAR CurrentValue = [Current WIP]
			VAR Baseline = [WIP Trend (30d Avg)]
			VAR ChangeRatio = DIVIDE ( CurrentValue - Baseline, Baseline )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentValue ) || ISBLANK ( Baseline ), "#6B7280",
			        ChangeRatio <= -0.1, "#2E7D32",
			        ChangeRatio <= 0.1, "#EF6C00",
			        "#C62828"
			    )
		lineageTag: b03d70f6-f32c-40d3-9073-cf500822af92

	column DateValue
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7945cb40-4bda-4ab2-afcd-a2916cf7c167
