table Features
	lineageTag: 92f33947-6d7a-4a82-ad29-ecd27c43a227

	measure 'Feature Completion %' =
			DIVIDE (
			    SUM ( Features[Completed Story Count] ),
			    SUM ( Features[Completed Story Count] ) + SUM ( Features[Open Story Count] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8b794d6a-d6c4-41df-8f8f-6762a3e35ae2

	measure 'Overdue Features Count' =
			CALCULATE (
			    COUNTROWS ( Features ),
			    FILTER ( Features, Features[Overdue] = TRUE () )
			)
		formatString: #,0
		lineageTag: 1a3b4cd6-9960-40ef-8416-9d31618495ee

	measure 'Overdue Features %' = DIVIDE ( [Overdue Features Count], COUNTROWS ( Features ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 35025a9a-5c57-4b9b-a2a0-6e7d83eaa98c

	measure 'Estimated Effort Progress KPI %' =
			DIVIDE (
			    SUM ( Features[Completed Estimated Effort Dev] ),
			    SUM ( Features[Completed Estimated Effort Dev] ) + SUM ( Features[Open Estimated Effort Dev] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 11e6a14e-0552-412b-86ca-2a7f38f22a35

	measure 'Actual vs Estimated Effort KPI %' =
			DIVIDE (
			    SUM ( Features[Completed Actual Effort Dev] ),
			    SUM ( Features[Completed Estimated Effort Dev] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 19633e9e-c955-4a1c-a2db-7db977fd9b66

	measure 'Feature Link' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    SELECTEDVALUE ( 'Feature User Stories'[Link] ),
			    SELECTEDVALUE ( Features[Link] )
			)
		lineageTag: 5747fa54-a5d7-4b06-8051-23e657af867a
		dataCategory: WebUrl

	measure 'Feature Matrix Story Count' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    COUNTROWS ( 'Feature User Stories' ),
			    SUM ( Features[Descendant Count] )
			)
		formatString: #,0
		lineageTag: 6a9a6d50-8657-4ef6-baf5-7e4a8b6f013f

	measure 'Feature Matrix Open Story Count' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", 0, 1 ),
			    SUM ( Features[Open Story Count] )
			)
		formatString: #,0
		lineageTag: e72186df-0688-4ea5-a608-c3c47b343aa7

	measure 'Feature Matrix Completed Story Count' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", 1, 0 ),
			    SUM ( Features[Completed Story Count] )
			)
		formatString: #,0
		lineageTag: ce43f94b-645a-44e8-8ec0-4a563d5ed6aa

	measure 'Feature Matrix Completed Estimated Effort' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", SELECTEDVALUE ( 'Feature User Stories'[Estimated Effort Dev] ), 0 ),
			    SUM ( Features[Completed Estimated Effort Dev] )
			)
		formatString: #,0.0
		lineageTag: 566df3dc-b9b3-4c8f-81ec-f3e4d3f1ffd3

	measure 'Feature Matrix Open Estimated Effort' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", 0, SELECTEDVALUE ( 'Feature User Stories'[Estimated Effort Dev] ) ),
			    SUM ( Features[Open Estimated Effort Dev] )
			)
		formatString: #,0.0
		lineageTag: b5e8f22d-c71b-4923-a0a5-974927f8ad57

	measure 'Feature Matrix Total Estimated Effort' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    SELECTEDVALUE ( 'Feature User Stories'[Estimated Effort Dev] ),
			    SUM ( Features[Descendant Estimated Effort Dev] )
			)
		formatString: #,0.0
		lineageTag: 4d208c1f-8d47-476e-960b-5b955c9be640

	measure 'Feature Matrix Completed Actual Effort' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", SELECTEDVALUE ( 'Feature User Stories'[Actual Effort Dev] ), 0 ),
			    SUM ( Features[Completed Actual Effort Dev] )
			)
		formatString: #,0.0
		lineageTag: fdc31b47-cf5d-42c8-948c-48bb66045b6d

	measure 'Feature Matrix Estimated Effort Progress %' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    IF ( SELECTEDVALUE ( 'Feature User Stories'[State Category] ) = "Completed", 1, 0 ),
			    DIVIDE ( SUM ( Features[Completed Estimated Effort Dev] ), SUM ( Features[Descendant Estimated Effort Dev] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0edff0e4-3b52-4e13-a249-aea8e17e9c6d

	measure 'Feature Matrix Actual vs Estimated Effort %' =
			IF (
			    ISINSCOPE ( 'Feature User Stories'[User Story] ),
			    DIVIDE ( SELECTEDVALUE ( 'Feature User Stories'[Actual Effort Dev] ), SELECTEDVALUE ( 'Feature User Stories'[Estimated Effort Dev] ) ),
			    DIVIDE ( SUM ( Features[Descendant Actual Effort Dev] ), SUM ( Features[Descendant Estimated Effort Dev] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 52603080-606e-425f-9fa8-eb23c5dc29a7

