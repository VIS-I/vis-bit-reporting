table 'Work Item Snapshot'
	lineageTag: 9b55cffe-770b-4a5d-8dd9-7ee3d3c967d6

	measure 'Open Estimated Effort' =
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Work Item Snapshot'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Work Item Snapshot'[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        SUMX (
			            VALUES ( 'Work Item Snapshot'[WorkItemId] ),
			            CALCULATE ( MAX ( 'Work Item Snapshot'[Custom_EstimatedEffortQG2] ) )
			        ),
			        TeamAreaFilter
			    )
		formatString: #,0.0
		lineageTag: 35b28142-b16a-4c33-aad5-932695fd072d

	measure 'Active Team Members at Snapshot' =
			VAR SnapshotDates = VALUES ( 'Work Item Snapshot'[DateValue] )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Cumulative Flow Diagram'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Cumulative Flow Diagram'[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Cumulative Flow Diagram'[AssignedTo.UserName] ),
			        TREATAS ( SnapshotDates, 'Cumulative Flow Diagram'[DateValue] ),
			        TeamAreaFilter,
			        FILTER (
			            'Cumulative Flow Diagram',
			            NOT ISBLANK ( 'Cumulative Flow Diagram'[AssignedTo.UserName] ) &&
			            NOT (
			                'Cumulative Flow Diagram'[State]
			                    IN { "Done", "Closed", "Removed", "Completed" }
			            )
			        )
			    )
		formatString: #,0
		lineageTag: c37e29cb-caf1-45f9-bffd-0563948ee851

	measure 'Open Effort per Team Member' = DIVIDE ( [Open Estimated Effort], [Active Team Members at Snapshot] )
		formatString: #,0.0
		lineageTag: 24dab733-5264-446a-8c99-157772692aa5

	measure 'Open Stories at Snapshot' =
			VAR SnapshotDate = MAX ( 'Work Item Snapshot'[DateValue] )
			VAR SelectedAreas = VALUES ( 'Team / Area'[AreaPath] )
			VAR TeamAreaFilter =
			    FILTER (
			        VALUES ( 'Work Item Snapshot'[AreaPath] ),
			        NOT ISFILTERED ( 'Team / Area'[Team] ) ||
			        'Work Item Snapshot'[AreaPath] IN SelectedAreas
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Work Item Snapshot'[WorkItemId] ),
			        'Work Item Snapshot'[DateValue] = SnapshotDate,
			        TeamAreaFilter
			    )
		formatString: #,0
		lineageTag: f3dfd710-3910-4dd5-a488-577facaf04d4

	measure 'Stories Done on Snapshot Date' =
			VAR SnapshotDate = MAX ( 'Work Item Snapshot'[DateValue] )
			RETURN
			    IF (
			        NOT ISBLANK ( SnapshotDate ),
			        CALCULATE (
			            [Story Throughput],
			            FILTER (
			                ALL ( 'Done Work'[ClosedDate] ),
			                'Done Work'[ClosedDate] >= SnapshotDate &&
			                'Done Work'[ClosedDate] < SnapshotDate + 1
			            )
			        )
			    )
		formatString: #,0
		lineageTag: b2b07f43-14f5-47e5-9dc3-60833dbf8e24

	measure 'Load Target Lower' = 20
		formatString: #,0
		lineageTag: 6162fc16-a08f-4bbd-b049-4bfca52b2d20

	measure 'Load Target Upper' = 30
		formatString: #,0
		lineageTag: c718af53-6468-4125-901a-f62f390c95e0

	measure 'Latest Open Effort per Team Member' =
			VAR LatestSnapshot =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot'[DateValue] )
			    )
			RETURN
			    CALCULATE (
			        [Open Effort per Team Member],
			        'Work Item Snapshot'[DateValue] = LatestSnapshot
			    )
		formatString: #,0.0
		lineageTag: a9442f0f-e5c7-49db-8f0b-35d5fcae84c1

	measure 'Snapshot Slow Movers %' =
			VAR SnapshotDate = MAX ( 'Work Item Snapshot'[DateValue] )
			VAR EligibleStories =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Work Item Snapshot'[WorkItemId] ),
			        FILTER (
			            'Work Item Snapshot',
			            NOT ( 'Work Item Snapshot'[State] IN { "In Concept", "On Hold" } )
			        )
			    )
			VAR SlowMovers =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Work Item Snapshot'[WorkItemId] ),
			        FILTER (
			            'Work Item Snapshot',
			            NOT ( 'Work Item Snapshot'[State] IN { "In Concept", "On Hold" } ) &&
			            NOT ISBLANK ( 'Work Item Snapshot'[ChangedDate] ) &&
			            DATEDIFF ( 'Work Item Snapshot'[ChangedDate], SnapshotDate, DAY ) > 30
			        )
			    )
			RETURN
			    DIVIDE ( SlowMovers, EligibleStories )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b492c00f-b3c5-4747-9984-20878840abca

	measure 'Latest Slow Movers %' =
			VAR LatestSnapshot =
			    CALCULATE (
			        MAX ( 'Work Item Snapshot'[DateValue] ),
			        REMOVEFILTERS ( 'Work Item Snapshot'[DateValue] )
			    )
			RETURN
			    CALCULATE (
			        [Snapshot Slow Movers %],
			        'Work Item Snapshot'[DateValue] = LatestSnapshot
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 736650f3-d501-4844-8d4b-25bd1c67d7e4

	measure 'Latest Open Effort Color' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Latest Open Effort per Team Member] ), "#6B7280",
			    [Latest Open Effort per Team Member] > 30, "#C62828",
			    [Latest Open Effort per Team Member] > 20, "#2E7D32",
			    "#EF6C00"
			)
		lineageTag: 03c4f581-1b70-4526-b03e-2645fdcbd501

	measure 'Latest Slow Movers Color' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Latest Slow Movers %] ), "#6B7280",
			    [Latest Slow Movers %] <= 0.15, "#2E7D32",
			    [Latest Slow Movers %] <= 0.25, "#EF6C00",
			    "#C62828"
			)
		lineageTag: 160291e6-1bce-4504-b5dd-25aadd2654f8

