	partition Repositories = m
		mode: import
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    Workspace = Source{[workspaceId="1d7f83bd-9b20-42de-9fc3-0f113e2024b2"]}[Data],
				    Repos = Workspace{[dataflowId="b4231eab-5517-456d-8f37-6d807330f9c9"]}[Data],
				    Commits = Repos{[entity="Commits"]}[Data],
				    RepositoryRows = Table.Distinct(Table.SelectColumns(Commits, {"repoId", "repoName", "Team"})),
				    WithIsDisabled = Table.AddColumn(RepositoryRows, "isDisabled", each null, type nullable text)
				in
				    WithIsDisabled

	annotation PBI_ResultType = Table

