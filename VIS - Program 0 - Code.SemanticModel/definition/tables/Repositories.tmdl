table Repositories
	lineageTag: 811d843a-4762-4ecf-9385-1d7414616c48

	column repoId
		dataType: string
		lineageTag: a13e8cb2-1e94-4abb-824f-a8dd9614da45
		summarizeBy: none
		sourceColumn: repoId

		annotation SummarizationSetBy = Automatic

	column repoName
