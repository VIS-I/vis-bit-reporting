table Deployments
	lineageTag: 3b44535c-2009-46dd-b870-85d9efd68a09

	measure 'Average Deployment Age (Days)' =
			
			AVERAGE ( Deployments[daysDeployedAgo] )
		formatString: 0
		lineageTag: b04e1f0f-7d44-484e-a0c0-2c4d22427eed

	measure 'Deployment Age Target (Days)' = 60
		formatString: 0
		lineageTag: 80e256cb-bc40-4fbf-a2ab-70f2215c8cd1

	measure 'Deployment Health Status' =
			
			VAR DeploymentAge = [Average Deployment Age (Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DeploymentAge ), "No deployment data",
			        DeploymentAge < 60, "Green",
			        DeploymentAge <= 90, "Orange",
			        "Red"
			    )
		lineageTag: f0b33adb-c788-40ed-b7e4-d2d75bf007a9

	measure 'Deployment Health Color' =
			
			SWITCH (
			    [Deployment Health Status],
			    "Green", "#107C10",
			    "Orange", "#FF8C00",
			    "Red", "#D13438",
			    "#808080"
			)
		lineageTag: 8b2913ab-50c8-4265-87e7-b0f1cc40a2fb

	measure 'Deployment Health Index' =
			
			VAR DeploymentAge = [Average Deployment Age (Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DeploymentAge ), BLANK (),
			        DeploymentAge < 60, 1,
			        DeploymentAge <= 90, 2,
			        3
			    )
		formatString: 0
		lineageTag: 14ad3a15-6d8d-4c42-8711-8f3adaa2c675

	measure 'Deployment Age Variance (Days)' =
			
			[Average Deployment Age (Days)] - [Deployment Age Target (Days)]
		formatString: 0
		lineageTag: 8965ac1b-51c4-44dc-a8ca-9c703d4980da

