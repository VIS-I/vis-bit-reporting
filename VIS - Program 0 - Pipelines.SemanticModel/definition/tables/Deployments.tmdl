	column EnvironmentSort =
			
			SWITCH(
			    LOWER ( TRIM ( [environment] ) ),
			    "dev", "1 - DEV",
			    "test", "2 - TEST",
			    "stage", "3 - STAGE",
			    "prod", "4 - PROD",
			    "99 - OTHER"
			)
		lineageTag: 02f8ab04-dbc2-487c-867e-4208cc015c0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Deployment Health' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [daysDeployedAgo] ), "No deployment data",
			    [daysDeployedAgo] < 60, "Green",
			    [daysDeployedAgo] <= 90, "Orange",
			    "Red"
			)
		lineageTag: 0d987b06-7c2d-4d01-b9c4-9496d7cf1269
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

