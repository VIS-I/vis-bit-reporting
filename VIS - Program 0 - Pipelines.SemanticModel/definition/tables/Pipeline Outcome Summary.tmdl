table 'Pipeline Outcome Summary'
	lineageTag: a3bb4a3a-d583-4ed1-acb2-5a20c0ca7294

	measure 'Pipeline Runs' = SUM('Pipeline Outcome Summary'[TotalCount])
		formatString: #,0
		lineageTag: 2e91d90a-0eb8-4093-b7c7-6d8dedabacf3

	measure 'Success Rate' =
			DIVIDE(
			    SUM('Pipeline Outcome Summary'[SucceededCount]) + SUM('Pipeline Outcome Summary'[PartiallySucceededCount]),
			    SUM('Pipeline Outcome Summary'[TotalCount])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5c55d6da-35b0-4b4b-b2fe-6b43d0350543

	measure 'Failed Runs' = SUM('Pipeline Outcome Summary'[FailedCount])
		formatString: #,0
		lineageTag: 62106d99-aa5c-40a9-8277-e14da5ce6728

	column PipelineName
		dataType: string
		lineageTag: 59fb5f82-dc79-46ec-bbba-d842d82a7725
		summarizeBy: none
		sourceColumn: PipelineName

	column TotalCount
		dataType: int64
		formatString: 0
		lineageTag: 83dad3b2-fa2e-4ad3-a6f5-26bb4151b10a
		summarizeBy: sum
		sourceColumn: TotalCount

		annotation SummarizationSetBy = Automatic

	column SucceededCount
		dataType: int64
		formatString: 0
		lineageTag: e8d15f0f-1981-4e05-a40d-3194c3b45899
		summarizeBy: sum
		sourceColumn: SucceededCount

		annotation SummarizationSetBy = Automatic

	column PartiallySucceededCount
		dataType: int64
		formatString: 0
		lineageTag: b68617be-ecba-4397-8fcb-a1fc8fc50a9a
		summarizeBy: sum
		sourceColumn: PartiallySucceededCount

		annotation SummarizationSetBy = Automatic

	column FailedCount
		dataType: int64
		formatString: 0
		lineageTag: 3c8d6c6d-7163-4c93-a310-34f805280898
		summarizeBy: sum
		sourceColumn: FailedCount

		annotation SummarizationSetBy = Automatic

	column CanceledCount
		dataType: int64
		formatString: 0
		lineageTag: 56b5fa4f-8a22-4eed-9541-8b17ec18be3d
		summarizeBy: sum
		sourceColumn: CanceledCount

		annotation SummarizationSetBy = Automatic

	partition 'Pipeline Outcome Summary' = m
		mode: import
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    Workspace = Source{[workspaceId="1d7f83bd-9b20-42de-9fc3-0f113e2024b2"]}[Data],
				    Pipelines = Workspace{[dataflowId="bbfa2960-daa8-4704-8d12-81d3c53fb0eb"]}[Data]
				in
				    Pipelines{[entity="Pipeline Outcome Summary"]}[Data]

	annotation PBI_NavigationStepName = Navigation

