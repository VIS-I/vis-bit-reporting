{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "pipelineOutcomeChart",
  "position": {
    "x": 20,
    "y": 100,
    "z": 1000,
    "height": 280,
    "width": 600,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Pipeline Outcome Summary"
                    }
                  },
                  "Property": "PipelineName"
                }
              },
              "queryRef": "Pipeline Outcome Summary.PipelineName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Pipeline Outcome Summary"
                    }
                  },
                  "Property": "Pipeline Runs"
                }
              },
              "queryRef": "Pipeline Outcome Summary.Pipeline Runs",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Pipeline Outcome Summary"
                    }
                  },
                  "Property": "Failed Runs"
                }
              },
              "queryRef": "Pipeline Outcome Summary.Failed Runs",
              "active": true
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}