table 'Deployment Snapshot'
	lineageTag: f80b0f19-0844-4798-ad53-eddf94a1dc75

	measure 'Average Deployment Age (Days)' =
			
			AVERAGE ( 'Deployment Snapshot'[daysDeployedAgo] )
		formatString: 0
		lineageTag: 279ad1d3-d760-47c5-af07-731c55d5e729

	measure 'Deployment Age Target (Days)' = 60
		formatString: 0
		lineageTag: 03f9a50e-148a-4f0f-82fa-80f8e1cbda13

	measure 'Deployment Health Status' =
			
			VAR DeploymentAge = [Average Deployment Age (Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DeploymentAge ), "No deployment data",
			        DeploymentAge < 60, "Green",
			        DeploymentAge <= 90, "Orange",
			        "Red"
			    )
		lineageTag: 73132236-fd81-4895-b684-f28039bfd7bb

	measure 'Deployment Health Color' =
			
			SWITCH (
			    [Deployment Health Status],
			    "Green", "#107C10",
			    "Orange", "#FF8C00",
			    "Red", "#D13438",
			    "#808080"
			)
		lineageTag: a94ee3b8-6655-4ef7-9491-75e3577c2981

	measure 'Deployment Health Index' =
			
			VAR DeploymentAge = [Average Deployment Age (Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DeploymentAge ), BLANK (),
			        DeploymentAge < 60, 1,
			        DeploymentAge <= 90, 2,
			        3
			    )
		formatString: 0
		lineageTag: c91d0b86-adbd-4b84-8ff7-a91dd77cd1ad

	measure 'Deployment Age Variance (Days)' =
			
			[Average Deployment Age (Days)] - [Deployment Age Target (Days)]
		formatString: 0
		lineageTag: 4d56c0de-758f-4f20-8099-a8c5e106978b

	measure 'Last Deployed' = MAX ( 'Deployment Snapshot'[deploymentDate] )
		formatString: General Date
		lineageTag: b9074f9d-219d-46b8-96b4-ac2397b87776

	measure 'Last Deployed in Days' =
			
			VAR LastDeployment = [Last Deployed]
			RETURN
			    IF (
			        ISBLANK ( LastDeployment ),
			        BLANK (),
			        DATEDIFF ( LastDeployment, TODAY (), DAY )
			    )
		formatString: 0
		lineageTag: 78cf5e96-f854-40d7-9490-76d4862e502a

	measure Services = DISTINCTCOUNT ( 'Deployment Snapshot'[serviceName] )
		formatString: 0
		lineageTag: c3551754-9254-4669-9f33-e7dc2bc90097

	measure 'Running Deployments' =
			
			CALCULATE (
			    COUNTROWS ( 'Deployment Snapshot' ),
			    'Deployment Snapshot'[status] = "Running"
			)
		formatString: 0
		lineageTag: 9785b86e-d996-4f04-af96-f0401facd011

	measure 'Stopped Deployments' =
			
			CALCULATE (
			    COUNTROWS ( 'Deployment Snapshot' ),
			    'Deployment Snapshot'[status] = "Stopped"
			)
		formatString: 0
		lineageTag: b85a194d-e595-4956-bb62-ac0a57684779

	measure 'Latest Snapshot Updated' = MAX ( 'Deployment Snapshot'[snapshotModifiedAt] )
		formatString: dd MMM yyyy HH:mm
		lineageTag: ed6b46fc-2742-4d3d-8880-d30e10eb1388

