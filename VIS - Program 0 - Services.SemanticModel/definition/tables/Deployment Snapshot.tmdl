	column EnvironmentSort =
			
			SWITCH(
			    LOWER ( TRIM ( [environment] ) ),
			    "dev", "1 - DEV",
			    "test", "2 - TEST",
			    "stage", "3 - STAGE",
			    "prod", "4 - PROD",
			    "99 - OTHER"
			)
		lineageTag: e1f86c2e-56d8-4839-9e97-a53b06a937ac
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Deployment Health' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [daysDeployedAgo] ), "No deployment data",
			    [daysDeployedAgo] < 60, "Green",
			    [daysDeployedAgo] <= 90, "Orange",
			    "Red"
			)
		lineageTag: 8f49df14-9874-44b7-914a-2f3f17d86bb7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

