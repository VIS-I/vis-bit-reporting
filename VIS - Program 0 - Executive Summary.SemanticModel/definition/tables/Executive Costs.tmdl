table 'Executive Costs'
	lineageTag: d9e505e4-c70c-4f60-8e11-4e7b4a699dc5

	measure 'Executive Effective Cost (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR CurrencyCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			        )
			    )
			RETURN
			    IF (
			        CurrencyCount = 1,
			        CALCULATE (
			            SUM ( 'Executive Costs'[EffectiveCost] ),
			            FILTER (
			                ALL ( 'Executive Costs'[ChargePeriodStart] ),
			                'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			                'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			            )
			        )
			    )
		formatString: #,0.00
		lineageTag: 4ea3142e-72c1-48bf-a7ca-6f339e4f6253

	measure 'Executive Cost Currency (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR CurrencyCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			        )
			    )
			RETURN
			    SWITCH (
			        CurrencyCount,
			        0, "NOT AVAILABLE",
			        1,
			            CALCULATE (
			                SELECTEDVALUE ( 'Executive Costs'[BillingCurrency] ),
			                FILTER (
			                    ALL ( 'Executive Costs'[ChargePeriodStart] ),
			                    'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			                    'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			                )
			            ),
			        "MULTIPLE CURRENCIES"
			    )
		lineageTag: 11b1b749-f80e-499e-9bf9-e3f73d7901c9

	measure 'Executive Effective Cost MoM Change %' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR LatestCurrency =
			    CALCULATE (
			        SELECTEDVALUE ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			        )
			    )
			VAR PreviousCurrency =
			    CALCULATE (
			        SELECTEDVALUE ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= PreviousCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthStart
			        )
			    )
			VAR LatestCost = [Executive Effective Cost (Latest Completed Month)]
			VAR PreviousCost =
			    CALCULATE (
			        SUM ( 'Executive Costs'[EffectiveCost] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= PreviousCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthStart
			        )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( LatestCurrency ) && LatestCurrency = PreviousCurrency,
			        DIVIDE ( LatestCost - PreviousCost, PreviousCost )
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: b2dee62f-9bf7-46e1-b328-00bece00fadb

	measure 'Executive AI Investments (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR CurrencyCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			        ),
			        'Executive Costs'[Executive Cost Category] = "AI Investments"
			    )
			RETURN
			    IF (
			        CurrencyCount = 1,
			        CALCULATE (
			            SUM ( 'Executive Costs'[EffectiveCost] ),
			            FILTER (
			                ALL ( 'Executive Costs'[ChargePeriodStart] ),
			                'Executive Costs'[ChargePeriodStart] >= LatestCompletedMonthStart &&
			                'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthEnd + 1
			            ),
			            'Executive Costs'[Executive Cost Category] = "AI Investments"
			        )
			    )
		formatString: #,0.00
		lineageTag: 6859e182-7e9b-4a25-b02d-4ce7c9790197

	measure 'Executive AI Investments MoM Change %' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR LatestCurrency = [Executive Cost Currency (Latest Completed Month)]
			VAR PreviousCurrency =
			    CALCULATE (
			        SELECTEDVALUE ( 'Executive Costs'[BillingCurrency] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= PreviousCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthStart
			        )
			    )
			VAR LatestAIInvestment = [Executive AI Investments (Latest Completed Month)]
			VAR PreviousAIInvestment =
			    CALCULATE (
			        SUM ( 'Executive Costs'[EffectiveCost] ),
			        FILTER (
			            ALL ( 'Executive Costs'[ChargePeriodStart] ),
			            'Executive Costs'[ChargePeriodStart] >= PreviousCompletedMonthStart &&
			            'Executive Costs'[ChargePeriodStart] < LatestCompletedMonthStart
			        ),
			        'Executive Costs'[Executive Cost Category] = "AI Investments"
			    )
			RETURN
			    IF (
			        LatestCurrency = PreviousCurrency,
			        DIVIDE ( LatestAIInvestment - PreviousAIInvestment, PreviousAIInvestment )
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: c48d7d51-3b2e-4a9b-8127-efc993b7805f

	measure 'Executive AI Investment Share of Effective Cost %' =
			DIVIDE (
			    [Executive AI Investments (Latest Completed Month)],
			    [Executive Effective Cost (Latest Completed Month)]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0d2e8fc6-b763-47db-8c1f-bd05b6538070

	measure 'Executive Effective Cost with Change (Selected Month)' =
			VAR CurrentValue = [Executive Effective Cost (Latest Completed Month)]
			VAR Change = [Executive Effective Cost MoM Change %]
			RETURN
				IF (
					ISBLANK ( CurrentValue ),
					BLANK (),
					FORMAT ( CurrentValue, "#,0.00" ) &
						IF (
							ISBLANK ( Change ),
							BLANK (),
							" (" & FORMAT ( Change, "+0.0%;-0.0%;0.0%" ) & ")"
						)
				)
		lineageTag: 756edddc-2d3f-4a9a-84d3-8d446f8c4054

	measure 'Executive AI Investments with Change (Selected Month)' =
			VAR CurrentValue = [Executive AI Investments (Latest Completed Month)]
			VAR Change = [Executive AI Investments MoM Change %]
			RETURN
				IF (
					ISBLANK ( CurrentValue ),
					BLANK (),
					FORMAT ( CurrentValue, "#,0.00" ) &
						IF (
							ISBLANK ( Change ),
							BLANK (),
							" (" & FORMAT ( Change, "+0.0%;-0.0%;0.0%" ) & ")"
						)
				)
		lineageTag: 6e65c75f-e602-4faa-9f3e-185b7da4d12e

