	column 'Executive Service Tier' =
			SWITCH (
			    TRUE (),
			    NOT ISBLANK ( 'Executive Costs'[x_SkuTier] ) && 'Executive Costs'[x_SkuTier] <> "", 'Executive Costs'[x_SkuTier],
			    NOT ISBLANK ( 'Executive Costs'[x_SkuMeterCategory] ) && 'Executive Costs'[x_SkuMeterCategory] <> "", 'Executive Costs'[x_SkuMeterCategory],
			    NOT ISBLANK ( 'Executive Costs'[ServiceCategory] ) && 'Executive Costs'[ServiceCategory] <> "", 'Executive Costs'[ServiceCategory],
			    "Unclassified"
			)
		dataType: string
		lineageTag: ee704b3f-8902-42f3-8914-9c8ab5776235
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Executive Cost Category' =
			VAR ServiceName = LOWER ( COALESCE ( 'Executive Costs'[ServiceName], "" ) )
			VAR ServiceCategory = LOWER ( COALESCE ( 'Executive Costs'[ServiceCategory], "" ) )
			VAR MeterCategory = LOWER ( COALESCE ( 'Executive Costs'[x_SkuMeterCategory], "" ) )
			VAR MeterSubcategory = LOWER ( COALESCE ( 'Executive Costs'[x_SkuMeterSubcategory], "" ) )
			RETURN
			    IF (
			        CONTAINSSTRING ( ServiceName, "openai" ) ||
			        CONTAINSSTRING ( ServiceName, "cognitive" ) ||
			        CONTAINSSTRING ( ServiceName, "machine learning" ) ||
			        CONTAINSSTRING ( ServiceName, "ai search" ) ||
			        CONTAINSSTRING ( ServiceName, "content safety" ) ||
			        CONTAINSSTRING ( ServiceName, "bot service" ) ||
			        CONTAINSSTRING ( ServiceCategory, "artificial intelligence" ) ||
			        CONTAINSSTRING ( ServiceCategory, "ai + machine learning" ) ||
			        CONTAINSSTRING ( MeterCategory, "artificial intelligence" ) ||
			        CONTAINSSTRING ( MeterSubcategory, "openai" ),
			        "AI Investments",
			        "Other Cloud Services"
			    )
		dataType: string
		lineageTag: ccb06149-b5bd-4f2e-b1fc-47469dc5ae7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Executive Costs' = m
		mode: import
		source =
				let
					    StorageUrl = "https://finopshubrqoo5nfwqm4kk.dfs.core.windows.net/ingestion",
					    FirstIncludedMonth = Date.StartOfMonth ( Date.AddMonths ( Date.From ( DateTime.LocalNow () ), -3 ) ),
					    GetCostFileMonth = (folderPath as text) as nullable date =>
					        let
					            Segments = Text.Split ( Text.TrimEnd ( folderPath, "/" ), "/" ),
					            CostsIndex = List.PositionOf ( Segments, "Costs", Occurrence.Last ),
					            CurrentLayoutMonth =
					                if CostsIndex >= 0 and List.Count ( Segments ) > CostsIndex + 2 then
					                    try Date.FromText ( Segments{CostsIndex + 1} & "-" & Segments{CostsIndex + 2} & "-01" ) otherwise null
					                else
					                    null,
					            LegacyMonthSegment =
					                if CostsIndex > 0 then Segments{CostsIndex - 1} else null,
					            LegacyLayoutMonth =
					                if CurrentLayoutMonth = null and LegacyMonthSegment <> null and Text.Length ( LegacyMonthSegment ) = 6 then
					                    try Date.FromText ( Text.Start ( LegacyMonthSegment, 4 ) & "-" & Text.End ( LegacyMonthSegment, 2 ) & "-01" ) otherwise null
					                else
					                    null
					        in
					            if CurrentLayoutMonth <> null then CurrentLayoutMonth else LegacyLayoutMonth,
					    Source = AzureStorage.DataLake ( StorageUrl ),
					    CostFiles =
					        Table.SelectRows (
					            Source,
					            each [Attributes]?[Hidden]? <> true and
					                [Extension] = ".parquet" and
					                List.Contains ( Text.Split ( [Folder Path], "/" ), "Costs" )
					        ),
					    CostFilesWithMonth = Table.AddColumn ( CostFiles, "FileMonth", each GetCostFileMonth ( [Folder Path] ), type date ),
					    RecentCostFiles = Table.SelectRows ( CostFilesWithMonth, each [FileMonth] = null or [FileMonth] >= FirstIncludedMonth ),
					    RawCosts =
					        if Table.IsEmpty ( RecentCostFiles ) then
					            #table ( { "ChargePeriodStart", "EffectiveCost", "BillingCurrency", "SubAccountName", "ServiceCategory", "ServiceName", "ResourceName", "ResourceId", "x_SkuTier", "x_SkuMeterCategory", "x_SkuMeterSubcategory" }, {} )
					        else
					            Table.Combine ( List.Transform ( RecentCostFiles[Content], each Parquet.Document ( _ ) ) ),
					    SelectedColumns =
					        Table.SelectColumns (
					            RawCosts,
					            { "ChargePeriodStart", "EffectiveCost", "BillingCurrency", "SubAccountName", "ServiceCategory", "ServiceName", "ResourceName", "ResourceId", "x_SkuTier", "x_SkuMeterCategory", "x_SkuMeterSubcategory" },
					            MissingField.UseNull
					        ),
					    TypedColumns =
					        Table.TransformColumnTypes (
					            SelectedColumns,
					            {
					                { "ChargePeriodStart", type datetime },
					                { "EffectiveCost", type number },
					                { "BillingCurrency", type text },
					                { "SubAccountName", type text },
					                { "ServiceCategory", type text },
					                { "ServiceName", type text },
					                { "ResourceName", type text },
					                { "ResourceId", type text },
					                { "x_SkuTier", type text },
					                { "x_SkuMeterCategory", type text },
					                { "x_SkuMeterSubcategory", type text }
					            }
					        ),
					    RecentCosts =
					        Table.SelectRows (
					            TypedColumns,
					            each [ChargePeriodStart] <> null and Date.From ( [ChargePeriodStart] ) >= FirstIncludedMonth
					        )
					in
					    RecentCosts

