table 'Cumulative Flow Diagram'
	lineageTag: 97875062-0ed8-4f0f-a7d1-bbc1c71f4738

	measure 'Executive Active Contributors (Latest Completed Month)' = [Executive Active Developers (Latest Completed Month)]
		formatString: #,0
		lineageTag: 8aab4fe6-8b5a-42fa-9413-9971e172940d

	measure 'Executive Monthly Capacity (Person Days)' = [Executive Active Developers (Latest Completed Month)] * 20
		formatString: #,0 " person days"
		lineageTag: 4f20ee0c-59e4-411c-9acf-bc7ba83c622c

	measure 'Executive Active Developers (Latest Completed Month)' =
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR SnapshotDate =
			    CALCULATE (
			        MAX ( 'Cumulative Flow Diagram'[DateValue] ),
			        REMOVEFILTERS ( 'Cumulative Flow Diagram'[DateValue] ),
			        'Cumulative Flow Diagram'[DateValue] <= LatestCompletedMonthEnd
			    )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Cumulative Flow Diagram'[AssignedTo.UserName] ),
			        'Cumulative Flow Diagram'[DateValue] = SnapshotDate,
			        'Cumulative Flow Diagram'[WorkItemType] IN { "User Story", "Bug" },
			        'Cumulative Flow Diagram'[State] = "Active",
			        FILTER (
			            'Cumulative Flow Diagram',
			            NOT ISBLANK ( 'Cumulative Flow Diagram'[AssignedTo.UserName] ) &&
			            'Cumulative Flow Diagram'[AssignedTo.UserName] <> "NoAssignee"
			        )
			    )
		formatString: #,0
		lineageTag: f6f5d80d-5ad2-4542-b508-cccdbb768edc

	measure 'Executive Active Testers (Latest Completed Month)' =
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
