	measure 'Executive Delivery Flow Unmapped States (Latest Completed Month)' =
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR SnapshotDate =
			    CALCULATE (
			        MAX ( 'Cumulative Flow Diagram'[DateValue] ),
			        REMOVEFILTERS ( 'Cumulative Flow Diagram'[DateValue] ),
			        'Cumulative Flow Diagram'[DateValue] <= LatestCompletedMonthEnd
			    )
			RETURN
			    CALCULATE (
			        SUM ( 'Cumulative Flow Diagram'[Count] ),
			        'Cumulative Flow Diagram'[DateValue] = SnapshotDate,
			        'Cumulative Flow Diagram'[WorkItemType] IN { "User Story", "Bug" },
			        FILTER (
			            'Cumulative Flow Diagram',
			            NOT (
			                'Cumulative Flow Diagram'[State] IN {
			                    "New", "In Concept", "Ready for Refinement", "Ready for Development",
			                    "Active", "Resolved", "Ready for Testing", "Closed"
			                }
			            )
			        )
			    )
		formatString: #,0
		lineageTag: 31e2ae17-1c22-4bc3-9809-c1fc5084ee88

	measure 'Executive Delivery Flow Items (Six Complete Months)' =
			VAR FirstSnapshotDate = EOMONTH ( 'Reporting Month'[Executive Selected Reporting Month End], -6 ) + 1
			VAR LastSnapshotDate = 'Reporting Month'[Executive Selected Reporting Month End]
			RETURN
			    CALCULATE (
			        SUM ( 'Cumulative Flow Diagram'[Count] ),
			        KEEPFILTERS ( 'Cumulative Flow Diagram'[DateValue] >= FirstSnapshotDate ),
			        KEEPFILTERS ( 'Cumulative Flow Diagram'[DateValue] < LastSnapshotDate + 1 ),
			        KEEPFILTERS ( 'Cumulative Flow Diagram'[WorkItemType] IN { "User Story", "Bug" } ),
			        KEEPFILTERS (
			            'Cumulative Flow Diagram'[State] IN {
			                "New", "In Concept", "Ready for Refinement", "Ready for Development",
			                "Active", "Resolved", "Ready for Testing"
			            }
			        )
			    )
		formatString: #,0
		lineageTag: 3ff0144f-497a-45a6-a1ce-148ebf9b7b6d

