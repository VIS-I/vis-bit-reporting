	measure 'Executive Active Developers MoM Change' =
			[Executive Active Developers (Latest Completed Month)] -
				[Executive Active Developers (Previous Completed Month)]
		formatString: +0;-0;0
		lineageTag: 4f152b48-46fd-4236-aaae-5171b9598c93

	measure 'Executive Active Developers with Change (Selected Month)' =
			VAR CurrentValue = [Executive Active Developers (Latest Completed Month)]
			VAR Change = [Executive Active Developers MoM Change]
			RETURN
				IF (
					ISBLANK ( CurrentValue ),
					BLANK (),
					FORMAT ( CurrentValue, "0" ) &
						IF ( ISBLANK ( Change ), BLANK (), " (" & FORMAT ( Change, "+0;-0;0" ) & ")" )
				)
		lineageTag: d1e20687-e0f0-48e2-b6bd-7a588a769f1e

