	column 'Executive Delivery Flow Stage' =
			SWITCH (
			    TRUE (),
			    'Cumulative Flow Diagram'[State] IN { "New", "In Concept" }, "New / In Concept",
			    'Cumulative Flow Diagram'[State] = "Ready for Refinement", "Ready for Refinement",
			    'Cumulative Flow Diagram'[State] = "Ready for Development", "Ready for Development",
			    'Cumulative Flow Diagram'[State] = "Active", "Active",
			    'Cumulative Flow Diagram'[State] = "Resolved", "Resolved",
			    'Cumulative Flow Diagram'[State] = "Ready for Testing", "Ready for Testing",
			    'Cumulative Flow Diagram'[State] = "Closed", "Closed",
			    "Unmapped States"
			)
		dataType: string
		lineageTag: 7d501dd2-26ae-4772-a249-27ea075a63cc
		summarizeBy: none
		sortByColumn: 'Executive Delivery Flow Stage Sort'

		annotation SummarizationSetBy = Automatic

	column 'Executive Delivery Flow Stage Sort' =
			SWITCH (
			    TRUE (),
			    'Cumulative Flow Diagram'[State] IN { "New", "In Concept" }, 1,
			    'Cumulative Flow Diagram'[State] = "Ready for Refinement", 2,
			    'Cumulative Flow Diagram'[State] = "Ready for Development", 3,
			    'Cumulative Flow Diagram'[State] = "Active", 4,
			    'Cumulative Flow Diagram'[State] = "Resolved", 5,
			    'Cumulative Flow Diagram'[State] = "Ready for Testing", 6,
			    'Cumulative Flow Diagram'[State] = "Closed", 7,
			    8
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 77f920ce-c897-42ca-9174-d1a68257fe1b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Cumulative Flow Diagram' = m
		mode: import
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    #"1d7f83bd-9b20-42de-9fc3-0f113e2024b2" = Source{[workspaceId="1d7f83bd-9b20-42de-9fc3-0f113e2024b2"]}[Data],
				    #"1d72647c-62cb-46ba-91f9-0eb5c71bb512" = #"1d7f83bd-9b20-42de-9fc3-0f113e2024b2"{[dataflowId="1d72647c-62cb-46ba-91f9-0eb5c71bb512"]}[Data],
				    #"Cumulative Flow Diagram1" = #"1d72647c-62cb-46ba-91f9-0eb5c71bb512"{[entity="Cumulative Flow Diagram"]}[Data]
				in
				    #"Cumulative Flow Diagram1"

