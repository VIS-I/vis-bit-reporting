table Backlog
	lineageTag: 4d3161d7-b9de-4c6d-bf88-58ac083947e8

	measure 'Executive Active Delivery Backlog' =
			CALCULATE (
			    DISTINCTCOUNT ( Backlog[WorkItemId] ),
			    FILTER ( Backlog, NOT ( Backlog[State] IN { "In Concept", "On Hold" } ) )
			)
		formatString: #,0
		lineageTag: 3ed3f420-ca66-46d5-98e4-175dccd1fb8d

	measure 'Executive Backlog Planned End Date Coverage %' =
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        FILTER (
			            Backlog,
			            NOT ( Backlog[State] IN { "In Concept", "On Hold" } ) &&
			            NOT ISBLANK ( Backlog[Planned End Date] )
			        )
			    ),
			    [Executive Active Delivery Backlog]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 75c8084a-3adc-4372-86da-9f0c3282b028

	measure 'Executive Backlog Planning Coverage Color' =
			VAR PlanningCoverage = [Executive Backlog Planned End Date Coverage %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( PlanningCoverage ), "#6B6B6B",
			        PlanningCoverage >= 0.9, "#107C10",
			        PlanningCoverage >= 0.75, "#CA5010",
			        "#D13438"
			    )
		lineageTag: 90a0652d-f390-4214-b788-e443cd4d2df1

	measure 'Executive Backlog Estimation Coverage %' =
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        FILTER (
			            Backlog,
			            NOT ( Backlog[State] IN { "In Concept", "On Hold" } ) &&
			            NOT ISBLANK ( Backlog[Estimated Effort Dev] )
			        )
			    ),
			    [Executive Active Delivery Backlog]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 758072b8-8b7a-4d3c-a730-410b90ed42aa

	measure 'Executive Backlog Estimation Coverage Color' =
			VAR EstimationCoverage = [Executive Backlog Estimation Coverage %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( EstimationCoverage ), "#6B6B6B",
			        EstimationCoverage >= 0.9, "#107C10",
			        EstimationCoverage >= 0.75, "#CA5010",
			        "#D13438"
			    )
		lineageTag: 9b60c2a3-aa4d-420c-bf26-b1e1c310033d

	measure 'Executive Active Defect Load %' =
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( Backlog[WorkItemId] ),
			        FILTER (
			            Backlog,
			            Backlog[WorkItemType] = "Bug" &&
			            NOT ( Backlog[State] IN { "In Concept", "On Hold" } )
			        )
			    ),
			    [Executive Active Delivery Backlog]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 098c1088-088c-4e19-8152-4332f6ebae2f

	measure 'Executive Active Defect Load Color' =
			VAR DefectLoad = [Executive Active Defect Load %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DefectLoad ), "#6B6B6B",
			        DefectLoad <= 0.1, "#107C10",
			        DefectLoad <= 0.2, "#CA5010",
			        "#D13438"
			    )
		lineageTag: 4d12e4cb-7e00-40eb-8ff5-68420f95116a

	measure 'Executive In Concept Backlog %' =
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( Backlog[WorkItemId] ), Backlog[State] = "In Concept" ),
			    DISTINCTCOUNT ( Backlog[WorkItemId] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6f3c148f-4bfe-4e38-bfcb-2b9d39a9c381

	measure 'Executive On Hold Backlog %' =
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( Backlog[WorkItemId] ), Backlog[State] = "On Hold" ),
			    DISTINCTCOUNT ( Backlog[WorkItemId] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a986b450-18d2-45bd-a21f-0eee68904423

