table SonarQube
	lineageTag: 32428f7c-5230-45dd-921a-1aa026ae6f0d

	measure 'Executive Quality Score' =
			VAR LatestDate =
			    CALCULATE ( MAX ( SonarQube[date] ), REMOVEFILTERS ( SonarQube ) )
			RETURN
			    DIVIDE (
			        CALCULATE ( AVERAGE ( SonarQube[kpi_percent] ), SonarQube[date] = LatestDate ),
			        100
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c12d9c6c-c5c4-423f-a95f-53fd9780af85

	measure 'Executive Quality Risk Color' =
			VAR QualityScore = [Executive Quality Score]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( QualityScore ), "#6B6B6B",
			        QualityScore >= 0.9, "#107C10",
			        QualityScore >= 0.8, "#CA5010",
			        "#D13438"
			    )
		lineageTag: 5792f997-f1a8-407c-8f8d-758c86b1fcc0

