	measure 'Executive Monthly Delivery Health Severity' =
			VAR LeadTime = [Executive Median Lead Time (Latest Completed Month)]
			VAR LeadTimeSeverity =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LeadTime ), BLANK (),
			        LeadTime < 30, 1,
			        LeadTime < 35, 2,
			        3
			    )
			VAR CycleTime = [Executive Median Cycle Time (Latest Completed Month)]
			VAR CycleTimeSeverity =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CycleTime ), BLANK (),
			        CycleTime < 15, 1,
			        CycleTime < 20, 2,
			        3
			    )
			VAR CapacityLoad = [Executive Capacity Load (Proxy) %]
			VAR CapacityLoadSeverity =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CapacityLoad ), BLANK (),
			        CapacityLoad >= 0.7 && CapacityLoad <= 1, 1,
			        CapacityLoad >= 0.5 && CapacityLoad <= 1.2, 2,
			        3
			    )
			VAR DefectRate = [Executive Delivery Defect Rate (Latest Completed Month)]
			VAR DefectRateSeverity =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DefectRate ), BLANK (),
			        DefectRate <= 0.1, 1,
			        DefectRate <= 0.2, 2,
			        3
			    )
			RETURN
			    MAXX (
			        { LeadTimeSeverity, CycleTimeSeverity, CapacityLoadSeverity, DefectRateSeverity },
			        [Value]
			    )
		lineageTag: 344c0f93-5b4a-4bd9-a3f4-8bda3fd76e42

	measure 'Executive Monthly Delivery Status' =
			VAR Severity = [Executive Monthly Delivery Health Severity]
			RETURN
