table 'Done Work'
	lineageTag: ad8d5c4e-d3c1-43d0-9bc8-48d6aa71607d

	measure 'Executive Median Cycle Time (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			RETURN
			    CALCULATE (
			        MEDIAN ( 'Done Work'[Cycle Time Days] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= LatestCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthEnd + 1
			        )
			    )
		formatString: #,0.0 " days"
		lineageTag: 19b30f79-6d36-4a01-94e2-c69135a139f8

	measure 'Executive Median Lead Time (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			RETURN
			    CALCULATE (
			        MEDIAN ( 'Done Work'[Lead Time Days] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= LatestCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthEnd + 1
			        )
			    )
		formatString: #,0.0 " days"
		lineageTag: 11e58597-80c9-4317-8d39-b15d0f61c688

	measure 'Executive Lead Time MoM Change' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR CurrentValue = [Executive Median Lead Time (Latest Completed Month)]
			VAR PreviousValue =
			    CALCULATE (
			        MEDIAN ( 'Done Work'[Lead Time Days] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= PreviousCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthStart
			        )
			    )
			RETURN
			    CurrentValue - PreviousValue
		formatString: +0.0;-0.0;0.0 " days"
		lineageTag: 98ff27ae-086c-4a6b-b3a7-8c0d64d6a142

	measure 'Executive Cycle Time MoM Change' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR CurrentValue = [Executive Median Cycle Time (Latest Completed Month)]
			VAR PreviousValue =
			    CALCULATE (
			        MEDIAN ( 'Done Work'[Cycle Time Days] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= PreviousCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthStart
			        )
			    )
			RETURN
			    CurrentValue - PreviousValue
		formatString: +0.0;-0.0;0.0 " days"
		lineageTag: 5d53ba6b-5b7e-4e79-85e0-f145d0a16791

	measure 'Executive Delivery Defect Rate (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR CompletedBugs =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        'Done Work'[WorkItemType] = "Bug",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= LatestCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthEnd + 1
			        )
			    )
			VAR CompletedStories =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= LatestCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthEnd + 1
			        )
			    )
			RETURN
			    DIVIDE ( CompletedBugs, CompletedBugs + CompletedStories )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 40a5b5be-c4c7-4112-88e9-b0e87e49043c

	measure 'Executive Delivered Estimated Effort (Latest Completed Month)' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR LatestCompletedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			RETURN
			    CALCULATE (
			        SUMX (
			            VALUES ( 'Done Work'[WorkItemId] ),
			            CALCULATE ( MAX ( 'Done Work'[Estimated Effort Dev] ) )
			        ),
			        'Done Work'[WorkItemType] IN { "User Story", "Bug" },
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= LatestCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthEnd + 1
			        )
			    )
		formatString: #,0.0 " person days"
		lineageTag: 6767b23e-e3e7-4322-89a7-137db1040745

	measure 'Executive Capacity Load (Proxy) %' =
			DIVIDE (
			    [Executive Delivered Estimated Effort (Latest Completed Month)],
			    'Cumulative Flow Diagram'[Executive Monthly Capacity (Person Days)]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5c827c38-b8b6-405e-8112-0631e9db4535

	measure 'Executive Capacity Load Color' =
			VAR CapacityLoad = [Executive Capacity Load (Proxy) %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CapacityLoad ), "#6B6B6B",
			        CapacityLoad >= 0.7 && CapacityLoad <= 1, "#107C10",
			        CapacityLoad >= 0.5 && CapacityLoad <= 1.2, "#CA5010",
			        "#D13438"
			    )
		lineageTag: b45debe5-3909-4ebc-995c-f53e91fe3f97

	measure 'Executive Lead Time Health Color' =
			VAR LeadTime = [Executive Median Lead Time (Latest Completed Month)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LeadTime ), "#6B6B6B",
			        LeadTime < 30, "#107C10",
			        LeadTime < 35, "#CA5010",
			        "#D13438"
			    )
		lineageTag: c1213645-5954-4b0d-b762-e51f43247f40

	measure 'Executive Lead Time Change Color' =
			VAR CurrentValue = [Executive Median Lead Time (Latest Completed Month)]
			VAR ChangeRatio = DIVIDE ( [Executive Lead Time MoM Change], CurrentValue - [Executive Lead Time MoM Change] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentValue ) || ISBLANK ( ChangeRatio ), "#6B6B6B",
			        ChangeRatio <= -0.1, "#107C10",
			        ChangeRatio <= 0.1, "#CA5010",
			        "#D13438"
			    )
		lineageTag: b99f12b1-1aa3-45f5-a0b0-9f130c9495ba

	measure 'Executive Cycle Time Change Color' =
