	measure 'Executive Flow Health Color' =
			VAR CycleTime = [Executive Median Cycle Time (Latest Completed Month)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CycleTime ), "#6B6B6B",
			        CycleTime < 15, "#107C10",
