	measure 'Executive Actual-to-Estimated Effort Ratio (Selected Month)' =
			VAR SelectedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR SelectedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR EligibleWorkItems =
				FILTER (
					CALCULATETABLE (
						SUMMARIZE (
							'Done Work',
							'Done Work'[WorkItemId],
							"EstimatedEffort", MAX ( 'Done Work'[Estimated Effort Dev] ),
							"ActualEffort", MAX ( 'Done Work'[Actual Effort Dev] )
						),
						'Done Work'[WorkItemType] IN { "User Story", "Bug" },
						FILTER (
							ALL ( 'Done Work'[ClosedDate] ),
							'Done Work'[ClosedDate] >= SelectedMonthStart &&
							'Done Work'[ClosedDate] < SelectedMonthEnd + 1
						)
					),
					[EstimatedEffort] > 0 && [ActualEffort] > 0
				)
			VAR EstimatedEffort =
				SUMX (
					EligibleWorkItems,
					[EstimatedEffort]
				)
			VAR ActualEffort =
				SUMX (
					EligibleWorkItems,
					[ActualEffort]
				)
			RETURN
				DIVIDE ( ActualEffort, EstimatedEffort )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e6894842-e1d0-4053-953f-687256c56465

	measure 'Executive Actual-to-Estimated Effort Ratio (Previous Month)' =
			VAR PreviousMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR SelectedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR EligibleWorkItems =
				FILTER (
					CALCULATETABLE (
						SUMMARIZE (
							'Done Work',
							'Done Work'[WorkItemId],
							"EstimatedEffort", MAX ( 'Done Work'[Estimated Effort Dev] ),
							"ActualEffort", MAX ( 'Done Work'[Actual Effort Dev] )
						),
						'Done Work'[WorkItemType] IN { "User Story", "Bug" },
						FILTER (
							ALL ( 'Done Work'[ClosedDate] ),
							'Done Work'[ClosedDate] >= PreviousMonthStart &&
							'Done Work'[ClosedDate] < SelectedMonthStart
						)
					),
					[EstimatedEffort] > 0 && [ActualEffort] > 0
				)
			VAR EstimatedEffort =
				SUMX (
					EligibleWorkItems,
					[EstimatedEffort]
				)
			VAR ActualEffort =
				SUMX (
					EligibleWorkItems,
					[ActualEffort]
				)
			RETURN
				DIVIDE ( ActualEffort, EstimatedEffort )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5493c2ce-336a-4380-88d1-4f2c01f31923

