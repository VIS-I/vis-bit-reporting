	measure 'Executive Delivery Defect Rate MoM Change' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR PreviousCompletedBugs =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        'Done Work'[WorkItemType] = "Bug",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= PreviousCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthStart
			        )
			    )
			VAR PreviousCompletedStories =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Done Work'[WorkItemId] ),
			        'Done Work'[WorkItemType] = "User Story",
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= PreviousCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthStart
			        )
			    )
			VAR PreviousValue = DIVIDE ( PreviousCompletedBugs, PreviousCompletedBugs + PreviousCompletedStories )
			RETURN
			    [Executive Delivery Defect Rate (Latest Completed Month)] - PreviousValue
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 48556b17-ea5f-42cb-90c9-44319c31760b

	measure 'Executive Capacity Load (Proxy) MoM Change' =
			VAR LatestCompletedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR PreviousCompletedMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR PreviousDeliveredEstimatedEffort =
			    CALCULATE (
			        SUMX (
			            VALUES ( 'Done Work'[WorkItemId] ),
			            CALCULATE ( MAX ( 'Done Work'[Estimated Effort Dev] ) )
			        ),
			        'Done Work'[WorkItemType] IN { "User Story", "Bug" },
			        FILTER (
			            ALL ( 'Done Work'[ClosedDate] ),
			            'Done Work'[ClosedDate] >= PreviousCompletedMonthStart &&
			            'Done Work'[ClosedDate] < LatestCompletedMonthStart
			        )
			    )
			VAR PreviousValue =
			    DIVIDE (
			        PreviousDeliveredEstimatedEffort,
			        'Cumulative Flow Diagram'[Executive Monthly Capacity (Previous Completed Month)]
			    )
			RETURN
			    [Executive Capacity Load (Proxy) %] - PreviousValue
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 0732d677-126c-408a-a4ab-42343537683c

