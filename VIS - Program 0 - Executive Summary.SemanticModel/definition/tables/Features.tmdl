table Features
	lineageTag: c9ecfa93-076e-409d-90ed-71afa424e6ed

	measure 'Executive Overdue Features' =
			CALCULATE (
			    DISTINCTCOUNT ( Features[WorkItemId] ),
			    Features[Overdue] = TRUE ()
			)
		formatString: #,0
		lineageTag: 71683979-bb7d-447b-a6b7-d78d5279ebf6

	measure 'Executive Active Features' =
			CALCULATE (
			    DISTINCTCOUNT ( Features[WorkItemId] ),
			    Features[StateCategory] <> "Completed"
			)
		formatString: #,0
		lineageTag: 8e13bd15-bf0e-4db3-bba8-b4ca9b14d9f2

	measure 'Executive Overdue Features %' = DIVIDE ( [Executive Overdue Features], [Executive Active Features] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c808e605-5dd1-462d-a5b6-27ebac26d20c

	measure 'Executive Commitment Risk Color' =
			VAR OverdueRate = [Executive Overdue Features %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( OverdueRate ), "#6B6B6B",
			        OverdueRate <= 0.05, "#107C10",
			        OverdueRate <= 0.1, "#CA5010",
			        "#D13438"
			    )
		lineageTag: dba13e7c-21e1-4412-93ff-fc398c5098b8

	measure 'Executive Active Feature Story Completion %' =
			DIVIDE (
			    CALCULATE (
			        SUM ( Features[Completed Story Count] ),
			        Features[StateCategory] <> "Completed"
			    ),
			    CALCULATE (
			        SUM ( Features[Descendant Count] ),
			        Features[StateCategory] <> "Completed"
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 66af5e9b-bae9-49b4-ae29-bc063e8bb1a7

	measure 'Executive Remaining User Stories (Active Features)' =
			CALCULATE (
			    SUM ( Features[Open Story Count] ),
			    Features[StateCategory] <> "Completed"
			)
		formatString: #,0
		lineageTag: f9d11c6d-1219-4cf9-9baa-d694476b9a21

