table 'Pull Requests Review Turnaround History'
	lineageTag: 14527ae5-2068-4048-84d1-d834b949e3de

	measure 'Executive Median PR Review Queue Age (Selected Month)' =
			VAR SelectedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR SelectedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			VAR SnapshotDate =
				CALCULATE (
					MAX ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					'Pull Requests Review Turnaround History'[snapshotDate] >= SelectedMonthStart,
					'Pull Requests Review Turnaround History'[snapshotDate] <= SelectedMonthEnd
				)
			VAR SnapshotTimestamp =
				CALCULATE (
					MAX ( 'Pull Requests Review Turnaround History'[extractedAt] ),
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					'Pull Requests Review Turnaround History'[snapshotDate] = SnapshotDate
				)
			RETURN
				CALCULATE (
					MEDIANX (
						FILTER (
							'Pull Requests Review Turnaround History',
							'Pull Requests Review Turnaround History'[status] = "active" &&
							'Pull Requests Review Turnaround History'[isDraft] = FALSE () &&
							'Pull Requests Review Turnaround History'[createdByType] = "Human" &&
							'Pull Requests Review Turnaround History'[reviewerCount] > 0 &&
							'Pull Requests Review Turnaround History'[waitingReviewerCount] > 0 &&
							NOT ISBLANK ( 'Pull Requests Review Turnaround History'[creationDate] )
						),
						DIVIDE (
							DATEDIFF (
								'Pull Requests Review Turnaround History'[creationDate],
								SnapshotTimestamp,
								MINUTE
							),
							1440
						)
					),
					'Pull Requests Review Turnaround History'[snapshotDate] = SnapshotDate,
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[extractedAt] )
				)
		formatString: #,0.0 " days"
		lineageTag: 621d7f26-1b7a-4a3d-8624-cce6dd738bdf

	measure 'Executive Median PR Review Queue Age (Previous Month)' =
			VAR PreviousMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR PreviousMonthEnd = 'Reporting Month'[Executive Selected Reporting Month Start] - 1
			VAR SnapshotDate =
				CALCULATE (
					MAX ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					'Pull Requests Review Turnaround History'[snapshotDate] >= PreviousMonthStart,
					'Pull Requests Review Turnaround History'[snapshotDate] <= PreviousMonthEnd
				)
			VAR SnapshotTimestamp =
				CALCULATE (
					MAX ( 'Pull Requests Review Turnaround History'[extractedAt] ),
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[snapshotDate] ),
					'Pull Requests Review Turnaround History'[snapshotDate] = SnapshotDate
				)
			RETURN
				CALCULATE (
					MEDIANX (
						FILTER (
							'Pull Requests Review Turnaround History',
							'Pull Requests Review Turnaround History'[status] = "active" &&
							'Pull Requests Review Turnaround History'[isDraft] = FALSE () &&
							'Pull Requests Review Turnaround History'[createdByType] = "Human" &&
							'Pull Requests Review Turnaround History'[reviewerCount] > 0 &&
							'Pull Requests Review Turnaround History'[waitingReviewerCount] > 0 &&
							NOT ISBLANK ( 'Pull Requests Review Turnaround History'[creationDate] )
						),
						DIVIDE (
							DATEDIFF (
								'Pull Requests Review Turnaround History'[creationDate],
								SnapshotTimestamp,
								MINUTE
							),
							1440
						)
					),
					'Pull Requests Review Turnaround History'[snapshotDate] = SnapshotDate,
					REMOVEFILTERS ( 'Pull Requests Review Turnaround History'[extractedAt] )
				)
		formatString: #,0.0 " days"
		lineageTag: 9c4f0b04-2654-48de-9964-0e5eced2c26f

	measure 'Executive PR Review Queue Age MoM Change' =
			[Executive Median PR Review Queue Age (Selected Month)] -
				[Executive Median PR Review Queue Age (Previous Month)]
		formatString: +0.0;-0.0;0.0 " days"
		lineageTag: 5e89c992-6ec9-4242-b510-e56ad3b2c540

	measure 'Executive PR Review Queue Age with Change (Selected Month)' =
			VAR CurrentValue = [Executive Median PR Review Queue Age (Selected Month)]
			VAR Change = [Executive PR Review Queue Age MoM Change]
			RETURN
				IF (
					ISBLANK ( CurrentValue ),
					BLANK (),
					FORMAT ( CurrentValue, "0.0" ) & " days" &
						IF (
							ISBLANK ( Change ),
							BLANK (),
							" (" & FORMAT ( Change, "+0.0;-0.0;0.0" ) & "d)"
						)
				)
		lineageTag: 07f5d8ce-078c-4c44-a1c3-5e6766d32bfe

	measure 'Executive PR Review Queue Age Color' =
			VAR QueueAge = [Executive Median PR Review Queue Age (Selected Month)]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( QueueAge ), "#6B6B6B",
					QueueAge <= 2, "#107C10",
					QueueAge <= 3, "#CA5010",
					"#D13438"
				)
		lineageTag: 12549c9b-ce54-4cb0-8333-8a32d6b10d9f

