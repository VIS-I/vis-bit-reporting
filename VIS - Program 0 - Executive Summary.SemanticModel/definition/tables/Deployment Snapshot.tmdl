table 'Deployment Snapshot'
	lineageTag: 6f0056fc-a751-4184-90a0-a662a3813780

	measure 'Executive Services Above Deployment Target' =
			VAR SnapshotDate = [Executive Deployment Snapshot Date (Display)]
			RETURN
				CALCULATE (
					DISTINCTCOUNT ( 'Deployment Snapshot'[serviceName] ),
					'Deployment Snapshot'[snapshotDate] = SnapshotDate,
					FILTER ( 'Deployment Snapshot', 'Deployment Snapshot'[daysDeployedAgo] > 90 )
				)
		formatString: #,0
		lineageTag: f3b6ebce-7045-4af4-9707-c575a1e4facd

	measure 'Executive Deployment Instances In Scope' =
			VAR SnapshotDate = [Executive Deployment Snapshot Date (Display)]
			RETURN
				CALCULATE (
					COUNTROWS ( 'Deployment Snapshot' ),
					'Deployment Snapshot'[snapshotDate] = SnapshotDate,
					FILTER (
						'Deployment Snapshot',
						NOT ISBLANK ( 'Deployment Snapshot'[daysDeployedAgo] )
					)
				)
		formatString: #,0
		lineageTag: 3f66f333-e3ae-4e97-9de0-e37c7a1d3745

	measure 'Executive Deployment Instances Above Target' =
			VAR SnapshotDate = [Executive Deployment Snapshot Date (Display)]
			RETURN
				CALCULATE (
					COUNTROWS ( 'Deployment Snapshot' ),
					'Deployment Snapshot'[snapshotDate] = SnapshotDate,
					FILTER ( 'Deployment Snapshot', 'Deployment Snapshot'[daysDeployedAgo] > 90 )
				)
		formatString: #,0
		lineageTag: 75a173bf-248c-4c72-93bd-34460179893d

	measure 'Executive Service Currency %' =
			DIVIDE (
			    [Executive Deployment Instances In Scope] - [Executive Deployment Instances Above Target],
			    [Executive Deployment Instances In Scope]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5c8b9ae7-3887-41a8-a7d9-f6213750060b

	measure 'Executive Service Currency Color' =
			VAR ServiceCurrency = [Executive Service Currency %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( ServiceCurrency ), "#6B6B6B",
			        ServiceCurrency = 1, "#107C10",
			        ServiceCurrency >= 0.9, "#CA5010",
			        "#D13438"
			    )
		lineageTag: e235413f-0d62-4fcc-87e9-072bc5dd549f

	measure 'Executive Deployment Snapshot Date (Selected Month)' =
			VAR SelectedMonthStart = 'Reporting Month'[Executive Selected Reporting Month Start]
			VAR SelectedMonthEnd = 'Reporting Month'[Executive Selected Reporting Month End]
			RETURN
				CALCULATE (
					MAX ( 'Deployment Snapshot'[snapshotDate] ),
					REMOVEFILTERS ( 'Deployment Snapshot'[snapshotDate] ),
					'Deployment Snapshot'[snapshotDate] >= SelectedMonthStart,
					'Deployment Snapshot'[snapshotDate] < SelectedMonthEnd + 1
				)
		formatString: General Date
		lineageTag: c15e50f6-6417-46f2-8e93-2e70f66a61db

	measure 'Executive Deployment Snapshot Date (Latest Available)' =
			CALCULATE (
				MAX ( 'Deployment Snapshot'[snapshotDate] ),
				REMOVEFILTERS ( 'Deployment Snapshot'[snapshotDate] )
			)
		formatString: General Date
		lineageTag: 17b89404-f89e-48c1-b08b-a473c616546c

	measure 'Executive Deployment Snapshot Date (Display)' =
			COALESCE (
				[Executive Deployment Snapshot Date (Selected Month)],
				[Executive Deployment Snapshot Date (Latest Available)]
			)
		formatString: General Date
		lineageTag: 927222b5-364d-4ae3-905f-cb57c218091c

	measure 'Executive Service Currency % (Previous Month)' =
			VAR PreviousMonthStart = 'Reporting Month'[Executive Previous Reporting Month Start]
			VAR PreviousMonthEnd = 'Reporting Month'[Executive Selected Reporting Month Start] - 1
			VAR SnapshotDate =
				CALCULATE (
					MAX ( 'Deployment Snapshot'[snapshotDate] ),
					REMOVEFILTERS ( 'Deployment Snapshot'[snapshotDate] ),
					'Deployment Snapshot'[snapshotDate] >= PreviousMonthStart,
					'Deployment Snapshot'[snapshotDate] < PreviousMonthEnd + 1
				)
			VAR InstancesInScope =
				CALCULATE (
					COUNTROWS ( 'Deployment Snapshot' ),
					'Deployment Snapshot'[snapshotDate] = SnapshotDate,
					FILTER (
						'Deployment Snapshot',
						NOT ISBLANK ( 'Deployment Snapshot'[daysDeployedAgo] )
					)
				)
			VAR InstancesAboveTarget =
				CALCULATE (
					COUNTROWS ( 'Deployment Snapshot' ),
					'Deployment Snapshot'[snapshotDate] = SnapshotDate,
					FILTER ( 'Deployment Snapshot', 'Deployment Snapshot'[daysDeployedAgo] > 90 )
				)
			RETURN
				DIVIDE ( InstancesInScope - InstancesAboveTarget, InstancesInScope )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cd621ce1-913c-441b-9c72-5c4e2fd0de68

	measure 'Executive Service Currency MoM Change' =
			VAR SelectedSnapshotDate = [Executive Deployment Snapshot Date (Selected Month)]
			RETURN
				IF (
					ISBLANK ( SelectedSnapshotDate ),
					BLANK (),
					[Executive Service Currency %] -
						[Executive Service Currency % (Previous Month)]
				)
		formatString: +0.0;-0.0;0.0 "pp"
		lineageTag: 8f46b4dc-7a0c-4251-ae23-edcf3b297fff

	measure 'Executive Service Currency with Change (Selected Month)' =
			VAR CurrentValue = [Executive Service Currency %]
			VAR Change = [Executive Service Currency MoM Change]
			VAR SelectedSnapshotDate = [Executive Deployment Snapshot Date (Selected Month)]
			RETURN
				IF (
					ISBLANK ( CurrentValue ),
					BLANK (),
					FORMAT ( CurrentValue, "0.0%" ) &
						IF (
							ISBLANK ( SelectedSnapshotDate ) || ISBLANK ( Change ),
							BLANK (),
							" (" & FORMAT ( Change * 100, "+0.0;-0.0;0.0" ) & "pp)"
						)
				)
		lineageTag: c92a849a-3e7a-4e52-9fef-b10e63f62316

