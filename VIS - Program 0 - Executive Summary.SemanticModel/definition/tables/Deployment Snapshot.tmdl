	partition 'Deployment Snapshot' = m
		mode: import
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    #"1d7f83bd-9b20-42de-9fc3-0f113e2024b2" = Source{[workspaceId="1d7f83bd-9b20-42de-9fc3-0f113e2024b2"]}[Data],
				    #"b4231eab-5517-456d-8f37-6d807330f9c9" = #"1d7f83bd-9b20-42de-9fc3-0f113e2024b2"{[dataflowId="b4231eab-5517-456d-8f37-6d807330f9c9"]}[Data],
				    #"Deployment Snapshot1" = #"b4231eab-5517-456d-8f37-6d807330f9c9"{[entity="Deployment Snapshot"]}[Data]
				in
				    #"Deployment Snapshot1"

