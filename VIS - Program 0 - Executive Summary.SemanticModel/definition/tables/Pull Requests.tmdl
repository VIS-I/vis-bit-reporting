table 'Pull Requests'
	lineageTag: 79681ecd-59ff-43ef-9dc8-c640c6c84455

	measure 'Executive Median PR Review Queue Age' =
			VAR HumanPRsWaitingForReview =
			    FILTER (
			        'Pull Requests',
			        'Pull Requests'[status] = "active" &&
			        'Pull Requests'[isDraft] = FALSE () &&
			        'Pull Requests'[createdByType] = "Human" &&
			        'Pull Requests'[reviewerCount] > 0 &&
			        'Pull Requests'[waitingReviewerCount] > 0 &&
			        NOT ISBLANK ( 'Pull Requests'[creationDate] )
			    )
			RETURN
			    MEDIANX (
			        HumanPRsWaitingForReview,
			        DIVIDE ( DATEDIFF ( 'Pull Requests'[creationDate], NOW (), MINUTE ), 1440 )
			    )
		formatString: #,0.0 " days"
		lineageTag: 6ee2ec2e-dc54-43f0-8f13-00a5590691fd

	measure 'Executive Human PRs Waiting Over 3 Days' =
			COUNTROWS (
			    FILTER (
			        'Pull Requests',
			        'Pull Requests'[status] = "active" &&
			        'Pull Requests'[isDraft] = FALSE () &&
			        'Pull Requests'[createdByType] = "Human" &&
			        'Pull Requests'[reviewerCount] > 0 &&
			        'Pull Requests'[waitingReviewerCount] > 0 &&
			        'Pull Requests'[creationDate] < TODAY () - 3
			    )
			)
		formatString: #,0
		lineageTag: 581193f4-2284-49ac-a846-c2d760a776a6

	measure 'Executive PR Review Queue Color' =
			VAR QueueAge = [Executive Median PR Review Queue Age]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( QueueAge ), "#6B6B6B",
			        QueueAge <= 2, "#107C10",
			        QueueAge <= 3, "#CA5010",
			        "#D13438"
			    )
		lineageTag: 8f5e3cd1-2d5a-43fc-a2a7-d53e5dbdbe36

