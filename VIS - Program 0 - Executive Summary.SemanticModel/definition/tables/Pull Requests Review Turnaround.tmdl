	measure 'Executive Unreviewed Stale PRs' =
			CALCULATE (
			    DISTINCTCOUNT ( 'Pull Requests Review Turnaround'[pullRequestId] ),
			    'Pull Requests Review Turnaround'[isUnreviewedStalePr] = TRUE ()
