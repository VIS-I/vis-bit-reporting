	partition Kalender = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2024,1,1), TODAY()),
				    "Year", YEAR([Date]),
				    "Month", MONTH([Date]),
				    "YYYY-MM", FORMAT([Date], "YYYY-MM"),
				    "Day", DAY([Date])
				)

	annotation PBI_Id = 621f65f3714b40b7868d6eef61510053

