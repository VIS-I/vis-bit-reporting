	column 'Deployment Health' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( [daysDeployedAgo] ), "No deployment data",
			    [daysDeployedAgo] < 60, "Green",
			    [daysDeployedAgo] <= 90, "Orange",
			    "Red"
			)
		lineageTag: 2ba5f339-c4e6-417c-a935-3ee6f1d5e5cd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Compliance Status'
		dataType: string
		lineageTag: 5eed5d06-11e3-4ea3-b8c3-e47a0e6de33b
		summarizeBy: none
		sourceColumn: Compliance Status

		annotation SummarizationSetBy = Automatic

	partition Deployments = m
		mode: import
		source =
				let
				    Source = PowerBI.Dataflows(null),
				    Workspace = Source{[workspaceId="1d7f83bd-9b20-42de-9fc3-0f113e2024b2"]}[Data],
				    Repos = Workspace{[dataflowId="b4231eab-5517-456d-8f37-6d807330f9c9"]}[Data],
				    Deployments = Repos{[entity="Deployments"]}[Data],
				    WithComplianceStatus = Table.AddColumn(Deployments, "Compliance Status", each
				        if [daysDeployedAgo] <> null and [daysDeployedAgo] < 60 then "Compliant" else "Non-compliant", type text)
				in
				    WithComplianceStatus

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

