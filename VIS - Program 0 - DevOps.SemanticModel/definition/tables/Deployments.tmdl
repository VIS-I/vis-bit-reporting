table Deployments
	lineageTag: 77ec785c-e22d-448e-a8e3-07c03f895d32

	measure 'Average Deployment Age (Days)' =
			
			AVERAGE ( Deployments[daysDeployedAgo] )
		formatString: 0
		lineageTag: dabba8c1-789e-48ca-8922-2572d53eb2a3

	measure 'Deployment Age Target (Days)' = 60
		formatString: 0
		lineageTag: 18e2a34b-79df-409b-b9e2-a3a4cd22dfc2

	measure 'Deployment Health Status' =
			
			VAR DeploymentAge = [Average Deployment Age (Days)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DeploymentAge ), "No deployment data",
			        DeploymentAge < 60, "Green",
			        DeploymentAge <= 90, "Orange",
			        "Red"
			    )
		lineageTag: 61fb6f36-04ff-4c5e-8c0a-6e7f0327f4b0

	measure 'Deployment Health Color' =
			
			SWITCH (
			    [Deployment Health Status],
			    "Green", "#107C10",
			    "Orange", "#FF8C00",
			    "Red", "#D13438",
			    "#808080"
			)
		lineageTag: d2da26d7-b4de-48de-9cf9-e1e3ecddafd3

